import java.util.Scanner;
class SeriesSum{
    public static void main(String[] abc){
        System.out.print("Enter n : ");
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        for(int i=1;i<=n;i++){
            if(i==n) System.out.print(i+" = ");
            else System.out.print(i+" + ");
        }
        int sum=(n*(n+1))/2;
        System.out.print(sum);
    }
}
