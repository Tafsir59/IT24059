import java.util.Scanner;
public class CGPACalculator {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter your id: ");
        String name = sc.next();
        System.out.print("Enter number of courses: ");
        int n = sc.nextInt();
        int[] a=new int[n];
        float credit=0;
        float total=0;
        for (int i = 0; i < n; i++) {
                System.out.print("Enter credit of course" + (i + 1) + ": ");
                int cre=sc.nextInt();
                System.out.print("Enter course"+(i+1)+" CT marks : ");
                int ct=sc.nextInt();
                System.out.print("Enter course"+(i+1)+" attendance marks : ");
                int att=sc.nextInt();
                System.out.print("Enter course"+(i+1)+" final exam marks : ");
                int fe=sc.nextInt();
                a[i]=(ct+att+fe)*cre;
                float gpa=0;
                if (a[i] >= 80) gpa = 4.0f;
                else if (a[i] >= 75) gpa = 3.75f;
                else if (a[i] >= 70) gpa = 3.50f;
                else if (a[i] >= 65) gpa = 3.25f;
                else if (a[i] >= 60) gpa = 3.0f;
                else if (a[i] >= 55) gpa = 2.75f;
                else if (a[i] >= 50) gpa = 2.50f;
                else if (a[i] >= 45) gpa = 2.25f;
                else if (a[i] >= 40) gpa = 2.0f;
                else gpa = 0;
                total+=gpa*cre;
                credit+=cre;
        }
        float grade=total/credit;
        System.out.println("The grade is "+grade);
        if(grade==4) System.out.println("The grade is A+");
        if(grade>=3.75 && grade<4) System.out.println("The grade is A");
        if(grade>=3.50 && grade<3.75) System.out.println("The grade is A-");
        if(grade>=3.25 && grade<3.50) System.out.println("The grade is B+");
        if(grade>=3.00 && grade<3.20) System.out.println("The grade is B");
        if(grade>=2.75 && grade<3.00) System.out.println("The grade is B-");
        if(grade>=2.50 && grade<2.75) System.out.println("The grade is C+");
        if(grade>=2.25 && grade<2.50) System.out.println("The grade is C");
        if(grade>=2.00 && grade<2.25) System.out.println("The grade is D");
        if(grade<2.00) System.out.println("The grade is F");
    }
}
